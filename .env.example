# Copiar a .env y reemplazar TODOS los valores. Nunca subir .env al repositorio.
POSTGRES_DB=sato
POSTGRES_USER=sato
POSTGRES_PASSWORD=cambiar-por-una-clave-larga
# openssl rand -base64 48
SATO_JWT_SECRET=cambiar-por-un-secreto-de-al-menos-32-caracteres
SATO_CORS_ORIGINS=http://localhost:8080
SATO_RATE_LIMIT=120/minute
WEB_PORT=8080
# Usuario administrador inicial (opcional). Se crea al cargar la BD.
SATO_ADMIN_EMAIL=
SATO_ADMIN_PASSWORD=
# Correo (opcional). Sin SMTP los mensajes se guardan como .eml en artifacts/outbox.
SATO_SMTP_HOST=
SATO_SMTP_PORT=587
SATO_SMTP_USER=
SATO_SMTP_PASSWORD=
SATO_SMTP_FROM=
SATO_BASE_URL=http://localhost:8080
SATO_SYNC_DIA=2
