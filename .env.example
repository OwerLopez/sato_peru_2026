# Copiar a .env y reemplazar TODOS los valores. Nunca subir .env al repositorio.
POSTGRES_DB=sato
POSTGRES_USER=sato
POSTGRES_PASSWORD=cambiar-por-una-clave-larga
# openssl rand -base64 48
SATO_JWT_SECRET=cambiar-por-un-secreto-de-al-menos-32-caracteres
SATO_CORS_ORIGINS=http://localhost:8080
SATO_RATE_LIMIT=120/minute
WEB_PORT=8080
# Interfaz en la que se publica la web (127.0.0.1 = solo este equipo; 0.0.0.0 = toda la red, sin HTTPS)
WEB_BIND=127.0.0.1
# Equivalente IPv6 ([::1] = solo este equipo; [::] = toda la red)
WEB_BIND6=[::1]
# Usuario administrador inicial (opcional). Se crea al cargar la BD.
SATO_ADMIN_EMAIL=
SATO_ADMIN_PASSWORD=
# Correo (opcional). Sin SMTP los mensajes se guardan como .eml en artifacts/outbox.
SATO_SMTP_HOST=
SATO_SMTP_PORT=587
SATO_SMTP_USER=
SATO_SMTP_PASSWORD=
SATO_SMTP_FROM=
SATO_BASE_URL=http://localhost:8080
SATO_SYNC_DIA=2
# Operacion autocontrolada del worker (docker compose --profile worker up -d worker)
SATO_SYNC_MAX_INTENTOS=3
# Correos que reciben avisos de operacion (sincronizacion fallida o rechazada, deriva del modelo). Separados por coma.
SATO_ALERTAS_EMAIL=
# Caida maxima de filas admitida en las tablas clave al recargar (0.2 = 20 %); por encima la carga se rechaza.
SATO_CARGA_CAIDA_MAX=0.2
